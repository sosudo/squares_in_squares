# Preserve the exact, hash-pinned upstream notice bytes (including CRLF).
portfolios/candidate-*/source-notices-*/* -text whitespace=cr-at-eol
vendor/notices/lightning-v19/* -text whitespace=cr-at-eol
# Native logs are immutable evidence, including their terminal blank lines.
portfolios/candidate-*/native-ancestry/selected-native-files/* -text whitespace=-blank-at-eof

# Preserve nested immutable native logs in consolidated portfolio ancestry.
portfolios/candidate-*/native-ancestry/**/*.log -text whitespace=-blank-at-eof

# Preserve newly released public notice bytes exactly.
vendor/notices/kmmm-v31/* -text whitespace=cr-at-eol,-blank-at-eof

# Preserve selected rigid logs and newly inherited notice terminators.
portfolios/candidate-*/rigid-native-ancestry/**/*.log -text whitespace=-blank-at-eof
portfolios/candidate-*/source-notices-kmmm31/* -text whitespace=cr-at-eol,-blank-at-eof
portfolios/candidate-*/kmmm31-proof/*.csv -text whitespace=cr-at-eol

# Exact new native logs and inherited GPU dependency license bytes.
portfolios/candidate-*/new-native-ancestry/**/*.log -text whitespace=-blank-at-eof
portfolios/candidate-*/new-native-ancestry/gpu-native-finish/gpu-source-notices/** -text whitespace=cr-at-eol,-blank-at-eof

# Preserve immutable original-reference control log terminators.
portfolios/candidate-*/reference-control-ancestry/**/*.log -text whitespace=-blank-at-eof

# Exact public35 decimal CSVs and nested source notices are hash-bound evidence.
portfolios/candidate-*/public-v35-proof/**/*.csv -text whitespace=cr-at-eol
portfolios/candidate-*/public-v35-proof/*.csv -text whitespace=cr-at-eol
portfolios/candidate-*/source-notices-kmmm35/** -text whitespace=cr-at-eol,-blank-at-eof

# Local search checkpoints retain exact historical logs and upstream evidence.
portfolios/search-*/evidence/**/*.log -text whitespace=-blank-at-eof
portfolios/search-*/evidence/**/source-evidence/** -text whitespace=cr-at-eol,-blank-at-eof
